# ============================================================
# متغيرات البيئة — Environment variables
# ============================================================
# انسخ هذا الملف إلى .env.local واملأ القيم.
# لا ترفع أي ملف .env حقيقي إلى المستودع.
# ============================================================

# قاعدة البيانات (PostgreSQL) — يستخدمها /api/health فقط حاليًا.
# المنهاج نفسه يُخزَّن في ملفات TypeScript داخل src/ وليس في قاعدة البيانات.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ============================================================
# مفتاح المعلم — Teacher solutions gate
# ============================================================
# حلول التمارين وشرحها لا تُرسل إلى المتصفح إطلاقًا.
# تُقرأ من الخادم فقط عبر /api/teacher-key بعد التحقق من كلمة المرور.
# اتركه فارغًا/غير موجود للتطوير؛ عندها يكون مسار المفتاح مقفلًا (503).
TEACHER_KEY_PASSWORD=

# ============================================================
# بوابة الموقع — Site-wide password gate
# ============================================================
# كلمة مرور واحدة تحمي صفحات المنصة كلها (/, /algebra, /geometry,
# /lesson/*) عبر src/proxy.ts، ويتحقّق منها /api/gate.
#
# • تُقرأ على الخادم فقط، ولا تصل إلى المتصفح ولا إلى أي حزمة عميل.
# • لا تضع القيمة الحقيقية هنا — تُضبط في بيئة النشر وحدها.
# • عند تركها فارغة: التطوير يبقى مفتوحًا، والإنتاج يُقفل بحالة 503.
# • حماية مستقلة تمامًا عن TEACHER_KEY_PASSWORD.
SITE_PASSWORD=
