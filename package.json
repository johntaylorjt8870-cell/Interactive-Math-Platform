{
  "name": "syrian-grade8-math-platform",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:math-direction": "node scripts/check-math-direction.mjs",
    "self-test": "node scripts/self-test.mjs",
    "test:gate": "node scripts/gate-test.mjs",
    "test:gate:e2e": "node scripts/gate-e2e.mjs",
    "audit:lesson": "node scripts/audit-lesson.mjs",
    "audit:lessons": "node scripts/audit-lesson.mjs --all",
    "audit:fixture": "node scripts/audit-lesson.mjs --fixture",
    "verify": "npm run lint && npm run typecheck && npm run check:math-direction && npm run self-test && npm run audit:lessons && npm run build && npm run test:gate"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.25.12",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
